rules_version = '2';
// Regole di sicurezza del database Fantacatt.
// Amministratore principale: buscaglia.gabriele02@gmail.com (la stessa email di config.js).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function owner() { return signedIn() && email() == 'buscaglia.gabriele02@gmail.com'; }
    function userDoc() { return /databases/$(database)/documents/users/$(email()); }
    function member() { return owner() || (signedIn() && exists(userDoc())); }
    function admin() { return owner() || (signedIn() && exists(userDoc()) && get(userDoc()).data.admin == true); }

    // Elenco degli allenatori autorizzati: ognuno legge solo la propria scheda, l'admin gestisce tutto.
    match /users/{id} {
      allow read: if admin() || (signedIn() && id == email());
      allow write: if admin();
    }
    // Dati della lega: li leggono solo gli autorizzati, li scrive solo l'admin.
    match /league/{doc} {
      allow read: if member();
      allow write: if admin();
    }
  }
}
